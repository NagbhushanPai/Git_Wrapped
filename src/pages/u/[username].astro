---
import Layout from '../../layouts/Layout.astro';
import LanguageChart from '../../components/LanguageChart';
import AnimatedCounter from '../../components/AnimatedCounter';
import { getGitHubProfile } from '../../lib/github';
import { getPersonaTag } from '../../lib/persona';

export const prerender = false;

const username = Astro.params.username ?? '';
const result = await getGitHubProfile(username);

const ogImage = new URL(`/api/og/${encodeURIComponent(username)}`, Astro.url).toString();
const shareUrl = Astro.url.toString();
const twitterText = encodeURIComponent(`My Git Wrapped profile as ${username}:`);
const twitterIntent = `https://x.com/intent/tweet?text=${twitterText}&url=${encodeURIComponent(shareUrl)}`;

const persona = result.ok ? getPersonaTag(result.profile) : null;
const isSparseProfile = result.ok && result.profile.stars === 0 && result.profile.publicRepos < 3 && result.profile.longestStreak === 0 && result.profile.mostActiveHour === null;
---

<Layout title={result.ok ? `${username} · Git Wrapped` : 'Git Wrapped'} description="Shareable GitHub stats and persona tags.">
	<Fragment slot="head">
		<meta property="og:type" content="website" />
		<meta property="og:title" content={result.ok ? `${username} · Git Wrapped` : 'Git Wrapped'} />
		<meta property="og:description" content={result.ok ? `${username}'s live Git Wrapped profile with stats, persona, and share card.` : 'Shareable GitHub stats and persona tags.'} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={result.ok ? `${username} · Git Wrapped` : 'Git Wrapped'} />
		<meta name="twitter:description" content={result.ok ? `${username}'s live Git Wrapped profile with stats, persona, and share card.` : 'Shareable GitHub stats and persona tags.'} />
		<meta name="twitter:image" content={ogImage} />
	</Fragment>
	<section class="mx-auto flex min-h-screen w-full max-w-7xl items-center px-4 py-10 sm:px-6 lg:px-8">
		{result.ok ? (
			<div class="w-full space-y-8">
				<div class="rounded-[2rem] border border-white/10 bg-slate-950/80 p-6 shadow-2xl shadow-black/30 backdrop-blur md:p-8">
					<div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
						<div class="flex items-start gap-4">
							<img src={result.profile.avatarUrl} alt={`${username} avatar`} class="h-20 w-20 rounded-3xl border border-white/10 object-cover" />
							<div>
								<p class="text-sm uppercase tracking-[0.35em] text-amber-300/80">Git Wrapped</p>
								<h1 class="mt-2 text-4xl font-black tracking-tight text-white md:text-6xl">{username}</h1>
								<p class="mt-3 max-w-2xl text-base leading-7 text-slate-300 md:text-lg">{result.profile.bio || 'No bio on file, but the commit trail still tells a story.'}</p>
							</div>
						</div>

						<div class={`persona-hero rounded-[1.9rem] border bg-gradient-to-br px-6 py-6 text-left md:min-w-[320px] md:px-8 md:py-8 md:text-right ${persona?.color ?? 'from-white/10 to-white/5 border-white/10 text-white'}`}>
							<p class="text-xs uppercase tracking-[0.35em] text-white/70">Persona tag</p>
							<div class="mt-2 text-3xl font-black leading-tight md:text-5xl">{persona ? `${persona.emoji} ${persona.label}` : 'Balanced Builder 🛠️'}</div>
						</div>
					</div>

					{isSparseProfile ? (
						<div class="rounded-[1.75rem] border border-white/10 bg-white/5 px-5 py-4 text-sm leading-7 text-slate-300 md:px-6">
							This profile is just getting started. There is not much public activity yet, so the cards below are a snapshot of an early GitHub footprint rather than a crowded history.
						</div>
					) : null}

					<div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
						<div class="stat-card rounded-3xl border border-white/10 bg-white/5 p-5">
							<p class="text-sm text-slate-400">Public repos</p>
							<p class="mt-2 text-3xl font-black text-white"><AnimatedCounter client:load target={result.profile.publicRepos} /></p>
						</div>
						<div class="stat-card rounded-3xl border border-white/10 bg-white/5 p-5">
							<p class="text-sm text-slate-400">Total stars</p>
							<p class="mt-2 text-3xl font-black text-white"><AnimatedCounter client:load target={result.profile.stars} /></p>
						</div>
						<div class="stat-card rounded-3xl border border-white/10 bg-white/5 p-5">
							<p class="text-sm text-slate-400">Top language</p>
							<p class="mt-2 text-3xl font-black text-white">{result.profile.topLanguage ? `${result.profile.topLanguage.name}` : 'None'}</p>
							<p class="mt-1 text-sm text-slate-400">{result.profile.topLanguage ? <><AnimatedCounter client:load target={result.profile.topLanguage.percentage} suffix="%" /> of repos</> : 'No language-coded repos'}</p>
						</div>
						<div class="stat-card rounded-3xl border border-white/10 bg-white/5 p-5">
							<p class="text-sm text-slate-400">Longest streak</p>
							<p class="mt-2 text-3xl font-black text-white"><AnimatedCounter client:load target={result.profile.longestStreak} suffix=" days" /></p>
							<p class="mt-1 text-xs text-slate-500">based on last {result.profile.responseWindowDays} days of public activity</p>
						</div>
					</div>
				</div>

				<div class="grid gap-6 xl:grid-cols-[1.3fr_0.7fr]">
					<div class="rounded-[2rem] border border-white/10 bg-slate-950/70 p-6 md:p-8">
						<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
							<div>
								<p class="text-sm uppercase tracking-[0.35em] text-amber-300/80">Language breakdown</p>
								<h2 class="mt-2 text-2xl font-bold text-white">Top 5 languages by repo count</h2>
							</div>
							{result.profile.mostActiveHour !== null ? <p class="text-sm text-slate-400">Most active hour: {result.profile.mostActiveHour}:00 UTC</p> : <p class="text-sm text-slate-400">Just getting started — no public activity in the last 90 days yet 🌱</p>}
						</div>
						<div class="mt-6">
							<LanguageChart client:load languages={result.profile.languages.slice(0, 5)} />
						</div>
					</div>

					<div class="order-first space-y-6 xl:order-none">
						<div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-lg shadow-black/20 md:p-8">
							<p class="text-sm uppercase tracking-[0.35em] text-amber-300/80">Share</p>
							<div class="mt-4 space-y-3">
								<button id="copy-link" class="group w-full rounded-2xl border border-amber-400/40 bg-amber-400/10 px-4 py-3 font-semibold text-amber-100 transition hover:-translate-y-0.5 hover:bg-amber-400/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
									<span class="inline-flex items-center gap-2">
										<span class="copy-icon inline-flex h-5 w-5 items-center justify-center rounded-full border border-current/20 text-sm transition duration-200">↗</span>
										<span class="copy-label transition duration-200">Copy link</span>
									</span>
								</button>
								<a href={twitterIntent} target="_blank" rel="noreferrer" class="block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-center font-semibold text-white transition hover:-translate-y-0.5 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">Share on X/Twitter</a>
							</div>
							<div class="mt-6 overflow-hidden rounded-3xl border border-white/10 bg-slate-950">
								<img src={ogImage} alt="OG image preview" class="aspect-[1200/630] w-full object-cover" />
							</div>
						</div>
					</div>
				</div>
			</div>
		) : (
			<div class="mx-auto max-w-xl rounded-[2rem] border border-white/10 bg-slate-950/80 p-8 text-center shadow-2xl shadow-black/30 backdrop-blur">
				<h1 class="text-4xl font-black text-white">{result.kind === 'not_found' ? "Couldn't find that user" : result.kind === 'rate_limited' ? 'Rate limited' : 'Something went wrong'}</h1>
				<p class="mt-4 text-slate-300">{result.message}</p>
				<a href="/" class="mt-6 inline-flex rounded-2xl border border-amber-400/40 bg-amber-400/10 px-5 py-3 font-semibold text-amber-100 transition hover:bg-amber-400/20">Back home</a>
			</div>
		)}
	</section>

	<script is:inline>
		const button = document.getElementById('copy-link');
		const icon = button?.querySelector('.copy-icon');
		const label = button?.querySelector('.copy-label');
		button?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				button.style.transform = 'scale(1.02)';
				if (icon) icon.textContent = '✓';
				if (label) label.textContent = 'Copied';
				setTimeout(() => {
					button.style.transform = '';
					if (icon) icon.textContent = '↗';
					if (label) label.textContent = 'Copy link';
				}, 1500);
			} catch {
				if (label) label.textContent = 'Copy failed';
			}
		});
	</script>
	<style>
		.persona-hero { animation: persona-reveal 700ms ease-out 180ms both; box-shadow: 0 0 48px rgba(245, 158, 11, 0.16), 0 0 0 1px rgba(245, 158, 11, 0.12) inset; }
		.stat-card { transition: transform 180ms ease, border-color 180ms ease, background 180ms ease; }
		.stat-card:hover { transform: translateY(-3px); border-color: rgba(245, 158, 11, 0.35); background: rgba(255,255,255,0.08); }
		@keyframes persona-reveal { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: scale(1); } }
	</style>
</Layout>
